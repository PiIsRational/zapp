%% NAME TupleReturn

Grammar: usize = Ones Alternating { $1 + $2 };

Ones: usize = (One One)+ { 
    blk: {
        var list = $1;
        defer list.deinit(self.allocator);
        var sum: usize = 0;
        for (list.items) |v| sum += v.@"0" + v.@"1";
        break :blk sum;
    }
};

Alternating: usize = (None One)+ {
    blk: {
        var list = $1;
        defer list.deinit(self.allocator);
        var sum: usize = 0;
        for (list.items) |v| sum += v;
        
        break :blk sum;
    }
};


One: usize = "1" { 1 };

None = "0";
